# ─── GetHired / Plate & Pen — environment variables ──────────────────────────
#
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env — it is listed in .gitignore.
# For production, set these as Cloudflare Worker secrets via:
#   wrangler secret put <VAR_NAME>
#
# ─────────────────────────────────────────────────────────────────────────────

# ── AI (Groq — primary) ───────────────────────────────────────────────────────
# Groq API key — primary AI provider (llama-3.3-70b-versatile).
# Obtain from: https://console.groq.com/keys
# Used by: cruise-cv-check.ts, parseCvForBuilder.ts, builder-assist.ts
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_GROQ_KEY

# ── AI (Gemini — fallback) ────────────────────────────────────────────────────
# Google Gemini 2.5 Flash key — automatic failover when Groq hits 429/5xx.
# Free tier: 15 RPM / 1 000 000 TPM / 250 req/day (July 2026).
# Obtain from: https://aistudio.google.com/app/apikey
# Used by: src/lib/ai/gemini-adapter.ts (provider router)
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_KEY

# ── Supabase (client-safe — exposed to browser via Vite) ──────────────────────
# Obtain from: Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ── Supabase (server-only — NEVER expose to browser) ─────────────────────────
# This key bypasses Row Level Security. Keep it in server functions only.
# Obtain from: Supabase dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── Lead capture webhook (optional) ──────────────────────────────────────────
# Google Apps Script webhook URL for WhatsApp lead capture.
# If absent, the saveCvLead server function returns {ok: true} silently.
# Obtain from: your Google Apps Script deployment URL
GOOGLE_SHEETS_LEAD_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# ── Microsoft Clarity (client-safe — exposed to browser via Vite) ─────────────
# Project ID from the Clarity dashboard (clarity.microsoft.com).
# If absent, all tracking calls are silently skipped (safe for local dev).
# IMPORTANT: After creating a project, set Masking to "Balanced" or "Strict"
# in Dashboard → Settings → Masking to prevent CV text / PII being recorded.
VITE_CLARITY_PROJECT_ID=YOUR_CLARITY_PROJECT_ID
