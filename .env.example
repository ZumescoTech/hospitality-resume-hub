# ─── GetHired / Plate & Pen — environment variables ──────────────────────────
#
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env — it is listed in .gitignore.
# For production, set these as Cloudflare Worker secrets via:
#   wrangler secret put <VAR_NAME>
#
# ─────────────────────────────────────────────────────────────────────────────

# ── AI (Groq) ─────────────────────────────────────────────────────────────────
# Named ANTHROPIC_API_KEY for historical reasons — the value is a Groq API key.
# Obtain from: https://console.groq.com/keys
# Used by: cruise-cv-check.ts, parseCvForBuilder.ts, builder-assist.ts
ANTHROPIC_API_KEY=gsk_REPLACE_WITH_YOUR_GROQ_KEY

# ── Supabase (client-safe — exposed to browser via Vite) ──────────────────────
# Obtain from: Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ── Supabase (server-only — NEVER expose to browser) ─────────────────────────
# This key bypasses Row Level Security. Keep it in server functions only.
# Obtain from: Supabase dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── Lead capture webhook (optional) ──────────────────────────────────────────
# Google Apps Script webhook URL for WhatsApp lead capture.
# If absent, the saveCvLead server function returns {ok: true} silently.
# Obtain from: your Google Apps Script deployment URL
GOOGLE_SHEETS_LEAD_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
