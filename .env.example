# --- GetHired / Plate & Pen — environment variables --------------------------
#
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env — it is listed in .gitignore.
# For production, set these as Cloudflare Worker secrets via:
#   wrangler secret put <VAR_NAME>
#
# -----------------------------------------------------------------------------

# -- AI (Groq — primary) -------------------------------------------------------
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_GROQ_KEY

# -- AI (Gemini — fallback) ----------------------------------------------------
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_KEY

# -- Supabase (client-safe — exposed to browser via Vite) ----------------------
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# -- Supabase (server-only — NEVER expose to browser) -------------------------
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# -- Lead capture webhook (optional) ------------------------------------------
GOOGLE_SHEETS_LEAD_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# -- Microsoft Clarity --------------------------------------------------------
VITE_CLARITY_PROJECT_ID=YOUR_CLARITY_PROJECT_ID

# -- GetHired CRM notify (optional, zero-cost webhook first) ------------------
LEAD_NOTIFY_WEBHOOK_URL=
LEAD_NOTIFY_EMAIL=
LEAD_NOTIFY_FROM=
RESEND_API_KEY=
VITE_WHATSAPP_BUSINESS_E164=
