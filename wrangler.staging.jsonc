{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hospitality-resume-hub-staging",
	"compatibility_date": "2025-09-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "@tanstack/react-start/server-entry",
	"vars": {
		"ENVIRONMENT": "staging"
	},
	"kv_namespaces": [
		{
			"binding": "CV_RESULT_CACHE",
			"id": "fe46b47db26245328ea464006925ecc8"
		}
	],
	"ai": {
		"binding": "AI"
	}
}
